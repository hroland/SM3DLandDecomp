+// Reviewed EU in-place normalization helper; original SDK symbol name is unknown.
+// Returns the length in s0 and leaves the vector unchanged when it is not positive.
+// The literal pool order (1.0f, then 0.0f) follows the original image.
+extern "C" __asm float __attribute__((section("i.FUN_0027ccbc")))
+FUN_0027ccbc(void* vector)
+{
+    vldmia r0, {s2-s4}
+    vmul.f32 s7, s2, s2
+    vmla.f32 s7, s3, s3
+    vmla.f32 s7, s4, s4
+    vsqrt.f32 s0, s7
+    vldr s1, FUN_0027ccbc_zero
+    vcmpe.f32 s0, s1
+    vmrs APSR_nzcv, FPSCR
+    bxle lr
+    vldr s7, FUN_0027ccbc_one
+    vdiv.f32 s6, s7, s0
+    vmul.f32 s8, s2, s6
+    vmul.f32 s9, s3, s6
+    vmul.f32 s10, s4, s6
+    vstmia r0, {s8-s10}
+    bx lr
+FUN_0027ccbc_one
+    DCD 0x3f800000
+FUN_0027ccbc_zero
+    DCD 0x00000000
+}
