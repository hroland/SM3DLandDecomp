+// EU matrix helpers reconstructed as assembly, following this SDK's existing
+// native VFP helper convention. Original symbol names are not established.
+// Pointer-only signatures preserve the observed ARM calling convention.
+extern "C" {
+
+__asm void __attribute__((section("i.FUN_0027cb9c")))
+FUN_0027cb9c(void* out, const void* matrix, const void* vector)
+{
+    vldmia r1, {s0-s11}
+    vldmia r2, {s12-s14}
+    vmla.f32 s3, s0, s12
+    vmla.f32 s7, s4, s12
+    vmla.f32 s11, s8, s12
+    vmla.f32 s3, s1, s13
+    vmla.f32 s7, s5, s13
+    vmla.f32 s11, s9, s13
+    vmla.f32 s3, s2, s14
+    vmla.f32 s7, s6, s14
+    vmla.f32 s11, s10, s14
+    vstr s3, [r0]
+    vstr s7, [r0, #4]
+    vstr s11, [r0, #8]
+    bx lr
+}
+
+__asm void __attribute__((section("i.FUN_00291470")))
+FUN_00291470(void* out, const void* matrix)
+{
+    cmp r1, r0
+    bxeq lr
+    vldmia r1!, {s0-s5}
+    mov r2, r0
+    vldmia r1, {s6-s11}
+    vstmia r2!, {s0-s5}
+    vstmia r2, {s6-s11}
+    bx lr
+}
+
+} // extern "C"
